---
import ChatBanner from '../components/ChatBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Afbeelding voor WhatsApp, Facebook en LinkedIn (1200 × 630). */
  image?: string;
  /** Pagina niet laten opnemen in Google (bijv. de 404-pagina). */
  noindex?: boolean;
  /** Extra gestructureerde gegevens (schema.org) voor deze pagina. */
  schema?: Record<string, unknown>;
  /** De banner "Start een gesprek" onderaan weglaten. */
  hideBanner?: boolean;
}
const {
  title = 'Vragen over stoelgang en vezels? AI-begeleider | Darmmanagement',
  description = 'Vragen over je stoelgang, buikklachten, vezels of Darmmanagement? Onze AI-begeleider denkt rustig met je mee en verwijst door waar nodig.',
  image = '/images/og-darmmanagement.jpg',
  noindex = false,
  schema,
  hideBanner = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const MENU: [href: string, label: string][] = [
  ['/', 'Welkom'],
  ['/winkel', 'Winkel'],
  ['/vezelcheck', 'Vezelcheck'],
  ['/product', 'Product'],
  ['/ervaringen', 'Ervaringen'],
  ['/veelgestelde-vragen', 'Vragen'],
  ['/over-ons', 'Over ons'],
];
const imageUrl = new URL(image, Astro.site).href;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Darmmanagement',
  url: new URL('/', Astro.site).href,
  email: 'detoxhelpdesk@gmail.com',
  parentOrganization: { '@type': 'Organization', name: 'Powerdetox', url: 'https://www.powerdetox.nl/' },
  sameAs: ['https://darmmanagement.nl/', 'https://www.powerdetox.nl/'],
};
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#1f4d3a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Darmmanagement" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="logo">DARM MANAGEMENT</a>
        <nav>
          {MENU.map(([href, label]) => <a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    {!hideBanner && <ChatBanner />}
    <footer class="site-footer">
      <div class="wrap foot">
        <a href="/start-een-gesprek">Start een gesprek</a>
        <a href="/winkel">Winkel</a>
        <a href="/veelgestelde-vragen">Veelgestelde vragen</a>
        <a href="/ervaringen">Ervaringen</a>
        <a href="/privacy">Privacy en gegevens</a>
        <a href="/medische-informatie">Medische informatie</a>
        <a href="/contact">Contact</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .logo { font-weight: 700; letter-spacing: .12em; font-size: .9rem; color: var(--green); text-decoration: none; }
  nav { display: flex; gap: 22px; }
  nav a { color: var(--ink); text-decoration: none; font-size: .95rem; white-space: nowrap; }
  .logo { white-space: nowrap; }
  @media (max-width: 480px) {
    .bar { flex-wrap: wrap; height: auto; padding-top: 12px; padding-bottom: 10px; row-gap: 6px; }
    nav { gap: 6px 16px; flex-wrap: wrap; }
  }
  nav a:hover { color: var(--green); text-decoration: underline; }
  nav a[aria-current='page'] { color: var(--green); font-weight: 600; }
  .site-footer { border-top: 1px solid var(--line); padding: 28px 0 40px; }
  .foot { display: flex; flex-wrap: wrap; gap: 8px 26px; font-size: .92rem; }
  .foot a { color: var(--muted); }
</style>
