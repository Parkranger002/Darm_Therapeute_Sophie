---
// Chatvenster: beeldvullend op telefoon, paneel rechts op groter scherm.
---
<div class="chat-backdrop" data-chat-backdrop hidden></div>
<section class="chat" id="chat" role="dialog" aria-modal="true" aria-labelledby="chat-title" hidden>
  <header class="chat-head">
    <div>
      <h2 id="chat-title"><span aria-hidden="true">🌿</span> Darmmanagement-begeleider</h2>
      <span class="badge">AI-begeleider</span>
    </div>
    <button class="close" type="button" data-close-chat aria-label="Chat sluiten">×</button>
  </header>

  <div class="log" data-log aria-live="polite"></div>

  <form class="composer" data-form autocomplete="off">
    <label class="sr-only" for="chat-input">Typ hier je vraag</label>
    <input id="chat-input" data-input type="text" placeholder="Typ hier je vraag…" maxlength="500" />
    <button class="btn send" type="submit">Verstuur</button>
  </form>
  <p class="privacy">
    Deel liever geen naam, adres of andere gegevens die voor je vraag niet nodig zijn.{' '}
    <a href="/privacy">Hoe gaan we met gegevens om?</a>
  </p>
</section>

<script>
  import { nodes, interpret, classify, type State, type Option } from '../lib/flow';
  import { checkAlarm, ALARM_REPLIES } from '../lib/safety';
  import {
    CHECK, estimateFibre, fibreResult, PRODUCT_CARD, SHOP_URL, PROEF_URL, HELPDESK,

    isSensitive, asksAboutProduct, alreadyUses,
  } from '../lib/nudges';
  import { CHOICES, TEVREDENHEID, VERHAAL, PLAATSEN, MAX_NAAM, MAX_EMAIL, validate as validateErvaring } from '../lib/ervaring';

  type Msg = { role: 'user' | 'assistant'; content: string };
  type Source = { title: string; url: string };

  const chat = document.getElementById('chat')!;
  const backdrop = document.querySelector<HTMLElement>('[data-chat-backdrop]')!;
  const log = chat.querySelector<HTMLElement>('[data-log]')!;
  const form = chat.querySelector<HTMLFormElement>('[data-form]')!;
  const input = chat.querySelector<HTMLInputElement>('[data-input]')!;

  // Modus: 'ai' (echte begeleider via /api/chat) of 'vast' (vaste antwoorden als terugval).
  let mode: 'ai' | 'vast' = 'ai';
  let history: Msg[] = [];
  let state: State = {};
  let current = 'welkom';
  let started = false;
  let busy = false;
  let lastFocus: HTMLElement | null = null;

  // Tips in de chat (vezelcheck, productkaart). Nooit na een alarmsignaal
  // of bij gevoelige onderwerpen; elk soort tip hooguit één keer per gesprek.
  let aiAnswers = 0;
  let sensitive = false;
  const shown = { check: false, product: false, ervaring: false };

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const TOPICS: Record<string, string> = {
    stoelgang: 'Ik heb een vraag over mijn stoelgang.',
    buik: 'Ik heb buikklachten.',
    product: 'Ik heb een vraag over Darmmanagement.',
  };
  const TOPIC_LABELS: Record<string, string> = {
    stoelgang: 'Mijn stoelgang',
    buik: 'Ik heb buikklachten',
    product: 'Vraag over Darmmanagement',
  };

  function scroll() {
    log.scrollTo({ top: log.scrollHeight, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  // Maakt https-links en links naar eigen pagina's klikbaar, zonder HTML te gebruiken.
  function appendLinked(el: HTMLElement, text: string) {
    const re = /(https:\/\/[^\s<>"')]+[^\s<>"').,;:!?])|((?<![\w/])\/(?:vezelcheck|product|over-ons|contact|privacy|medische-informatie|veelgestelde-vragen|ervaringen)\b)/g;
    let last = 0;
    for (const m of text.matchAll(re)) {
      const url = m[0];
      if (m.index! > last) el.append(text.slice(last, m.index));
      const a = document.createElement('a');
      a.href = url;
      a.textContent = url;
      if (url.startsWith('https://')) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
      el.append(a);
      last = m.index! + url.length;
    }
    if (last < text.length) el.append(text.slice(last));
  }

  function bubble(text: string, who: 'bot' | 'user', safety = false, sources: Source[] = []) {
    const el = document.createElement('div');
    el.className = `msg ${who}${safety ? ' safety' : ''}`;
    if (who === 'bot') appendLinked(el, text);
    else el.textContent = text; // altijd als tekst, nooit als HTML
    if (sources.length) {
      const list = document.createElement('div');
      list.className = 'sources';
      list.append('Bron: ');
      sources.forEach((s, i) => {
        if (!/^https:\/\//.test(s.url)) return;
        const a = document.createElement('a');
        a.href = s.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.textContent = s.title || new URL(s.url).hostname;
        if (i) list.append(' · ');
        list.append(a);
      });
      el.appendChild(list);
    }
    log.appendChild(el);
    scroll();
  }

  function typing() {
    const t = document.createElement('div');
    t.className = 'msg bot typing';
    t.setAttribute('aria-label', 'De begeleider typt');
    t.innerHTML = '<i></i><i></i><i></i>';
    log.appendChild(t);
    scroll();
    return t;
  }

  function clearOptions() {
    log.querySelectorAll('.options').forEach((o) => o.remove());
  }

  function renderOptions(opts: Option[], layout: 'chips' | 'cards' = 'chips') {
    if (!opts.length) return;
    const wrap = document.createElement('div');
    wrap.className = `options ${layout}`;
    for (const o of opts) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = layout === 'cards' ? 'card' : 'chip';
      if (layout === 'cards') {
        const strong = document.createElement('strong');
        strong.textContent = o.label;
        const span = document.createElement('span');
        span.textContent = o.hint ?? '';
        b.append(strong, span);
      } else {
        b.textContent = o.label;
      }
      b.addEventListener('click', () => choose(o));
      wrap.appendChild(b);
    }
    log.appendChild(wrap);
    scroll();
  }

  // ── Vaste antwoorden (terugval) ───────────────────────────
  async function go(id: string, prefix: string[] = []) {
    if (id === '__reset') return reset();
    const node = nodes[id] ?? nodes.onbekend;
    current = id;
    if (node.safety) state.safety = true;
    busy = true;
    clearOptions();
    for (const line of [...prefix, ...node.say(state)]) {
      const t = typing();
      await wait(reduceMotion ? 0 : Math.min(350 + line.length * 6, 1100));
      t.remove();
      bubble(line, 'bot', node.safety);
    }
    renderOptions(node.options?.(state) ?? [], node.layout);
    busy = false;
  }

  function choose(o: Option) {
    if (busy) return;
    if (mode === 'ai' && current === 'welkom') {
      // Startknoppen sturen een gewone vraag naar de begeleider.
      const key = Object.keys(TOPIC_LABELS).find((k) => TOPIC_LABELS[k] === o.label);
      if (o.next === 'anders') {
        clearOptions();
        bubble(o.label, 'user');
        bubble('Vertel gerust in je eigen woorden waar je mee zit.', 'bot');
        current = 'vrij';
        return;
      }
      return sendText(key ? TOPICS[key] : o.label, o.label);
    }
    bubble(o.hint ? `${o.label}: ${o.hint}` : o.label, 'user');
    if (o.save) state[o.save[0]] = o.save[1] as never;
    go(o.next);
  }

  // ── Echte begeleider ──────────────────────────────────────
  async function askAI(): Promise<void> {
    busy = true;
    clearOptions();
    const t = typing();
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ messages: history.slice(-14) }),
      });
      t.remove();
      if (res.status === 429) {
        bubble('Je stuurt veel berichten achter elkaar. Wacht even een minuut en probeer het dan opnieuw.', 'bot');
        history.pop();
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as { reply: string; sources?: Source[]; safety?: boolean };
      if (data.safety) state.safety = true;
      bubble(data.reply, 'bot', !!data.safety && /huisarts|112|medische hulp/.test(data.reply), data.sources ?? []);
      history.push({ role: 'assistant', content: data.reply });
      afterReply(history[history.length - 2]?.content ?? '', !!data.safety);
    } catch {
      t.remove();
      // Terugval: vaste antwoorden.
      mode = 'vast';
      const lastUser = history[history.length - 1]?.content ?? '';
      bubble('De AI-begeleider is even niet bereikbaar. Ik help je nu met vaste antwoorden.', 'bot');
      busy = false;
      const r = interpret(lastUser);
      if (r.save) state[r.save[0]] = r.save[1] as never;
      await go(r.next);
      return;
    } finally {
      busy = false;
    }
  }

  async function sendText(text: string, label = text) {
    bubble(label, 'user');
    if (isSensitive(text)) sensitive = true;
    clearOptions();
    // Alarmsignalen: direct een vast antwoord, ook zonder server.
    const alarm = checkAlarm(text);
    if (alarm) {
      state.safety = true;
      const lines = ALARM_REPLIES[alarm];
      history.push({ role: 'user', content: text }, { role: 'assistant', content: lines.join('\n\n') });
      busy = true;
      for (const line of lines) {
        const t = typing();
        await wait(reduceMotion ? 0 : 500);
        t.remove();
        bubble(line, 'bot', true);
      }
      busy = false;
      if (mode === 'vast') renderOptions(nodes.veilig_algemeen.options?.(state) ?? []);
      return;
    }
    if (mode === 'ai') {
      current = 'vrij';
      history.push({ role: 'user', content: text });
      return askAI();
    }
    handleVast(text);
  }

  function handleVast(text: string) {
    const node = nodes[current];
    const alarm = classify(text);
    if (alarm) return go(alarm.next);
    if (node?.expectsText) {
      state[node.expectsText.key] = text as never;
      return go(node.expectsText.next);
    }
    const r = interpret(text);
    if (r.save) {
      state[r.save[0]] = r.save[1] as never;
      return go(r.next, ['Dat kan vervelend zijn.']);
    }
    go(r.next);
  }


  // ── Tips: vezelcheck en productkaart ──────────────────────
  function tipsAllowed() {
    return mode === 'ai' && !state.safety && !sensitive;
  }

  type TipButton = { label: string; href?: string; external?: boolean; primary?: boolean; keep?: boolean; onClick?: () => void };

  function tip(title: string, text: string | string[], buttons: TipButton[], note?: string) {
    const el = document.createElement('div');
    el.className = 'nudge';
    el.setAttribute('role', 'status');
    const head = document.createElement('div');
    head.className = 'nudge-head';
    const label = document.createElement('span');
    label.className = 'nudge-label';
    label.textContent = 'Tip';
    const h = document.createElement('strong');
    h.textContent = title;
    const x = document.createElement('button');
    x.type = 'button';
    x.className = 'nudge-close';
    x.setAttribute('aria-label', 'Tip sluiten');
    x.textContent = '×';
    x.addEventListener('click', () => el.remove());
    head.append(label, h, x);
    el.appendChild(head);
    const lines = Array.isArray(text) ? text : [text];
    if (lines.length > 1) {
      const ul = document.createElement('ul');
      for (const l of lines) {
        const li = document.createElement('li');
        li.textContent = l;
        ul.appendChild(li);
      }
      el.appendChild(ul);
    } else {
      const p = document.createElement('p');
      p.textContent = lines[0];
      el.appendChild(p);
    }
    if (note) {
      const n = document.createElement('p');
      n.className = 'nudge-note';
      n.textContent = note;
      el.appendChild(n);
    }
    const row = document.createElement('div');
    row.className = 'nudge-actions';
    for (const b of buttons) {
      const btn = document.createElement(b.href ? 'a' : 'button') as HTMLAnchorElement & HTMLButtonElement;
      btn.className = b.primary ? 'nudge-btn primary' : 'nudge-btn';
      btn.textContent = b.label;
      if (b.href) {
        btn.href = b.href;
        if (b.external) { btn.target = '_blank'; btn.rel = 'noopener'; }
      } else {
        btn.type = 'button';
        btn.addEventListener('click', () => { if (!b.keep) el.remove(); b.onClick?.(); });
      }
      row.appendChild(btn);
    }
    el.appendChild(row);
    log.appendChild(el);
    scroll();
  }

  function afterReply(lastUser: string, safety: boolean) {
    if (safety || !tipsAllowed()) return;
    aiAnswers++;
    if (alreadyUses(lastUser) && !shown.ervaring) {
      shown.ervaring = true;
      return later(() => tip('Deel je ervaring', 'Gebruik je Darmmanagement al? We horen graag hoe het je bevalt. We plaatsen een ervaring alleen met jouw toestemming.', [
        { label: 'Deel je ervaring', primary: true, onClick: () => shareExperience() },
        { label: 'Nee, dank je', onClick: () => {} },
      ]));
    }
    if (asksAboutProduct(lastUser) && !shown.product) {
      return later(productCard);
    }
    if (aiAnswers >= 2 && !shown.check) {
      shown.check = true;
      later(() => tip('Eet jij genoeg vezels?', 'De meeste Nederlanders eten minder vezels dan het Voedingscentrum aanraadt. Doe de vezelcheck: zes korte vragen, binnen een minuut klaar.', [
        { label: 'Doe de vezelcheck', primary: true, onClick: () => runCheck() },
        { label: 'Nee, dank je', onClick: () => {} },
      ]));
    }
  }

  function later(fn: () => void) {
    setTimeout(() => { if (tipsAllowed() && !busy) fn(); }, reduceMotion ? 0 : 1200);
  }

  function productCard() {
    shown.product = true;
    tip(PRODUCT_CARD.title, PRODUCT_CARD.lines, [
      { label: 'Bestel op darmmanagement.nl', href: SHOP_URL, external: true, primary: true },
      { label: 'Meer over het product', href: '/product' },
      { label: 'Gratis probeerverpakking', href: PROEF_URL, external: true },
      { label: 'Deel je ervaring', keep: true, onClick: () => shareExperience() },
    ], PRODUCT_CARD.note);
  }


  function shareExperience() {
    shown.ervaring = true;
    if (log.querySelector('.ervaring-form')) return;
    bubble('Deel je ervaring', 'user');
    bubble('Leuk dat je je ervaring wilt delen! Het invullen duurt ongeveer twee minuten. Alleen de vragen met een * zijn verplicht.', 'bot');

    const form = document.createElement('form');
    form.className = 'nudge ervaring-form';
    form.noValidate = true;
    const answers: Record<string, string | number> = {};

    const group = (label: string, required = false) => {
      const fs = document.createElement('fieldset');
      const lg = document.createElement('legend');
      lg.textContent = label + (required ? ' *' : '');
      fs.appendChild(lg);
      form.appendChild(fs);
      return fs;
    };
    const choiceRow = (fs: HTMLElement, id: string, options: (string | number)[], onPick?: (v: string | number) => void) => {
      const row = document.createElement('div');
      row.className = 'choice-row';
      row.setAttribute('role', 'radiogroup');
      for (const o of options) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'choice';
        b.textContent = String(o);
        b.setAttribute('role', 'radio');
        b.setAttribute('aria-checked', 'false');
        b.addEventListener('click', () => {
          row.querySelectorAll('.choice').forEach((c) => c.setAttribute('aria-checked', 'false'));
          b.setAttribute('aria-checked', 'true');
          answers[id] = o;
          onPick?.(o);
        });
        row.appendChild(b);
      }
      fs.appendChild(row);
    };

    for (const q of CHOICES) choiceRow(group(q.label, q.required), q.id, q.options);
    choiceRow(group(TEVREDENHEID.label), TEVREDENHEID.id, [1, 2, 3, 4, 5]);

    const vs = group(VERHAAL.label);
    const hint = document.createElement('p');
    hint.className = 'nudge-note';
    hint.textContent = VERHAAL.hint;
    const ta = document.createElement('textarea');
    ta.maxLength = VERHAAL.max;
    ta.rows = 4;
    ta.setAttribute('aria-label', VERHAAL.label);
    vs.append(hint, ta);

    const nameWrap = document.createElement('label');
    nameWrap.className = 'field';
    nameWrap.textContent = 'Je voornaam *';
    const name = document.createElement('input');
    name.type = 'text';
    name.maxLength = MAX_NAAM;
    name.autocomplete = 'given-name';
    nameWrap.appendChild(name);
    nameWrap.hidden = true;
    const ps = group(PLAATSEN.label, true);
    choiceRow(ps, PLAATSEN.id, PLAATSEN.options, (v) => { nameWrap.hidden = v !== PLAATSEN.options[0]; });
    ps.appendChild(nameWrap);

    const es = group('Mogen we je mailen over je ervaring? (niet verplicht)');
    const email = document.createElement('input');
    email.type = 'email';
    email.maxLength = MAX_EMAIL;
    email.autocomplete = 'email';
    email.placeholder = 'je@email.nl';
    email.setAttribute('aria-label', 'E-mailadres (niet verplicht)');
    es.appendChild(email);

    // Verborgen veld tegen spambots.
    const trap = document.createElement('input');
    trap.name = 'website';
    trap.tabIndex = -1;
    trap.autocomplete = 'off';
    trap.className = 'trap';
    trap.setAttribute('aria-hidden', 'true');
    form.appendChild(trap);

    const privacy = document.createElement('p');
    privacy.className = 'nudge-note';
    privacy.textContent = 'Je antwoorden worden veilig bewaard en alleen door Darmmanagement gelezen. We plaatsen een ervaring alleen als je daar hierboven toestemming voor geeft. Wil je je ervaring later laten verwijderen? Mail dan naar ' + HELPDESK + '.';
    const status = document.createElement('p');
    status.className = 'form-status';
    status.setAttribute('role', 'alert');
    const actions = document.createElement('div');
    actions.className = 'nudge-actions';
    const send = document.createElement('button');
    send.type = 'submit';
    send.className = 'nudge-btn primary';
    send.textContent = 'Versturen';
    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'nudge-btn';
    cancel.textContent = 'Annuleren';
    cancel.addEventListener('click', () => { form.remove(); bubble('Geen probleem. Heb je nog een vraag? Typ hem hieronder.', 'bot'); });
    actions.append(send, cancel);
    form.append(privacy, status, actions);

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const data = {
        ...answers,
        verhaal: ta.value.trim() || undefined,
        voornaam: nameWrap.hidden ? undefined : name.value.trim() || undefined,
        email: email.value.trim() || undefined,
        website: trap.value || undefined,
      };
      const err = validateErvaring(data as never);
      if (err) { status.textContent = err; return; }
      status.textContent = 'Bezig met versturen…';
      send.disabled = true;
      try {
        const res = await fetch('/api/ervaring', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };
        if (!res.ok || !out.ok) throw new Error(out.message || (res.status === 429 ? 'Je hebt veel verstuurd. Probeer het over een minuut opnieuw.' : 'Versturen is niet gelukt.'));
        form.remove();
        bubble('Bedankt voor het delen van je ervaring! We lezen alles zelf. Als je toestemming hebt gegeven, kan je ervaring later op de website verschijnen.', 'bot');
      } catch (e) {
        send.disabled = false;
        status.textContent = (e as Error).message + ` Lukt het niet? Mail je ervaring naar ${HELPDESK}.`;
      }
    });

    log.appendChild(form);
    scroll();
  }

  async function runCheck() {
    shown.check = true;
    const answers: Record<string, number> = {};
    bubble('Doe de vezelcheck', 'user');
    bubble('Leuk! Zes korte vragen. Je antwoorden blijven op je eigen apparaat en worden niet opgeslagen.', 'bot');
    for (const q of CHECK) {
      if (q.skipIf?.(answers)) continue;
      const value = await askCheck(q.text, q.options);
      if (value === null) return; // bezoeker typte iets anders: check stopt
      answers[q.id] = value;
    }
    const result = fibreResult(estimateFibre(answers), answers.doel);
    for (const line of result.lines) bubble(line, 'bot');
    if (!result.offer || !tipsAllowed()) return;
    const yes = await askCheck('Wil je ook weten hoe je met Darmmanagement makkelijk vezels kunt aanvullen?', [
      { label: 'Ja, graag', value: 1 },
      { label: 'Nee, dank je', value: 0 },
    ]);
    if (yes) productCard();
    else if (yes === 0) bubble('Prima! Heb je nog een andere vraag? Typ hem hieronder.', 'bot');
  }

  function askCheck(text: string, options: { label: string; value: number }[]): Promise<number | null> {
    bubble(text, 'bot');
    return new Promise((resolve) => {
      const wrap = document.createElement('div');
      wrap.className = 'options chips';
      for (const o of options) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chip';
        b.textContent = o.label;
        b.addEventListener('click', () => {
          observer.disconnect();
          wrap.remove();
          bubble(o.label, 'user');
          resolve(o.value);
        });
        wrap.appendChild(b);
      }
      // Wordt de keuzelijst weggehaald (de bezoeker typt zelf), dan stopt de check.
      const observer = new MutationObserver(() => {
        if (!wrap.isConnected) { observer.disconnect(); resolve(null); }
      });
      observer.observe(log, { childList: true });
      log.appendChild(wrap);
      scroll();
    });
  }

  function reset() {
    state = {};
    history = [];
    aiAnswers = 0;
    sensitive = false;
    shown.check = shown.product = shown.ervaring = false;
    log.innerHTML = '';
    go('welkom');
  }

  function open(topic?: string) {
    lastFocus = document.activeElement as HTMLElement;
    chat.hidden = false;
    backdrop.hidden = false;
    document.body.classList.add('chat-open');
    if (!started) {
      started = true;
      if (topic && TOPICS[topic]) {
        go('welkom').then(() => sendText(TOPICS[topic], TOPIC_LABELS[topic]));
      } else {
        go('welkom');
      }
    } else if (topic && TOPICS[topic] && !busy) {
      sendText(TOPICS[topic], TOPIC_LABELS[topic]);
    }
    setTimeout(() => input.focus(), 50);
  }

  function close() {
    chat.hidden = true;
    backdrop.hidden = true;
    document.body.classList.remove('chat-open');
    lastFocus?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-open-chat]').forEach((el) =>
    el.addEventListener('click', () => open(el.dataset.openChat || undefined)),
  );
  chat.querySelector('[data-close-chat]')!.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !chat.hidden) close();
  });

  // Openen vanaf een andere pagina: /?chat opent de chat, /?ervaring opent meteen de vragenlijst.
  {
    const params = new URLSearchParams(location.search);
    if (params.has('ervaring') || params.has('chat')) {
      window.history.replaceState(null, '', location.pathname);
      if (params.has('ervaring')) {
        started = true;
        lastFocus = document.activeElement as HTMLElement;
        chat.hidden = false;
        backdrop.hidden = false;
        document.body.classList.add('chat-open');
        go('welkom').then(() => shareExperience());
      } else {
        open();
      }
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || busy) return;
    input.value = '';
    sendText(text);
  });
</script>

